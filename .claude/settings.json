{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(az login:*)",
      "Bash(az account get-access-token:*)",
      "Bash(az account show:*)",
      "Bash(az ad:*)",
      "Bash(docker exec:*)",
      "Bash(docker cp:*)",
      "Bash(docker inspect:*)",
      "Bash(docker logs:*)",
      "Read(~/.azure/**)",
      "Read(./config/contexts.yaml)",
      "Read(./.env)",
      "WebFetch(domain:127.0.0.1)",
      "WebFetch(domain:localhost)"
    ]
  }
}

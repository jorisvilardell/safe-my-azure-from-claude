{
  "name": "safe-my-azure-from-claude",
  "version": "0.1.0",
  "description": "Read-only, anonymising Azure MCP server: lets AI agents investigate Azure incidents without leaking credentials or identifiers.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e-mock": "vitest run --config vitest.e2e-mock.config.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@azure/arm-advisor": "^3.2.0",
    "@azure/arm-monitor": "^8.0.0",
    "@azure/arm-resourcegraph": "^5.0.0",
    "@azure/arm-resourcehealth": "^5.0.0",
    "@azure/core-auth": "^1.11.0",
    "@azure/core-rest-pipeline": "^1.25.0",
    "@azure/identity": "^4.14.1",
    "@azure/logger": "^1.4.0",
    "@azure/monitor-query-logs": "^1.0.0",
    "@azure/monitor-query-metrics": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@typespec/ts-http-runtime": "^0.3.9",
    "express": "^5.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}

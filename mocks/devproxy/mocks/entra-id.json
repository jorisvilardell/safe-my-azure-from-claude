              "preferred_network": "login.microsoftonline.com",
              "preferred_cache": "login.windows.net",
              "aliases": [
                "login.microsoftonline.com",
                "login.windows.net",
                "login.microsoft.com",
                "sts.windows.net"
              ]
            }
          ]
        }
      }
    },
    {
      "request": {
        "url": "https://login.microsoftonline.com/*/v2.0/.well-known/openid-configuration*",
        "method": "GET"

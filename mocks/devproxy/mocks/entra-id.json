          "id_token_signing_alg_values_supported": ["RS256"],
          "response_types_supported": ["code", "id_token", "code id_token", "id_token token"],
          "scopes_supported": ["openid", "profile", "email", "offline_access"],
          "issuer": "https://login.microsoftonline.com/00000000-0000-0000-0000-0000000000aa/v2.0",
          "request_uri_parameter_supported": false,
          "userinfo_endpoint": "https://graph.microsoft.com/oidc/userinfo",
          "authorization_endpoint": "https://login.microsoftonline.com/00000000-0000-0000-0000-0000000000aa/oauth2/v2.0/authorize",
          "device_authorization_endpoint": "https://login.microsoftonline.com/00000000-0000-0000-0000-0000000000aa/oauth2/v2.0/devicecode*",
          "http_logout_supported": true,
          "frontchannel_logout_supported": true,
          "end_session_endpoint": "https://login.microsoftonline.com/00000000-0000-0000-0000-0000000000aa/oauth2/v2.0/logout",
          "claims_supported": [
            "sub",
            "iss",
            "aud",
            "exp",
            "iat",
            "nonce",
            "name",
            "preferred_username",
            "oid",
            "tid",
            "ver"
          ],

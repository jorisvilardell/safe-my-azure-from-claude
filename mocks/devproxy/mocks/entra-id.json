{
  "$schema": "https://raw.githubusercontent.com/dotnet/dev-proxy/main/schemas/v4.0.0/mockresponseplugin.mocksfile.schema.json",
  "mocks": [
    {
      "request": {
        "url": "https://login.microsoftonline.com/common/discovery/instance*",
        "method": "GET"
      },
      "response": {
        "body": {
          "tenant_discovery_endpoint": "https://login.microsoftonline.com/00000000-0000-0000-0000-0000000000aa/v2.0/.well-known/openid-configuration",
          "api-version": "1.1",
          "metadata": [

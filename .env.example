# Copy to .env (gitignored). No secrets belong here — auth is interactive device-code.
PORT=8765
HOST=0.0.0.0
CONTEXTS_FILE=/app/config/contexts.yaml
LOG_LEVEL=info
# In-memory inventory index: max resources per context (0 disables it). Over the cap, tools
# query Resource Graph live. Never written to disk; dropped on logout and on restart.
INVENTORY_MAX_RESOURCES=50000
# MCP resource azure://inventory/<context>: sends EVERY resource name (no IDs) to the AI. Opt-in.
INVENTORY_RESOURCE=off
# Audit trail of tool calls, one scrubbed JSON line each: stderr (default) | file | off.
AUDIT_LOG=stderr
# Only with AUDIT_LOG=file (rejected otherwise). Append-only JSON Lines, no rotation.
# AUDIT_LOG_FILE=/app/audit/audit.jsonl
